---
import { Image } from 'astro:assets';
import implantBefore from '../assets/images/gallery/Anterior-Implant_Case-1_Before.jpg';
import implantAfter from '../assets/images/gallery/Anterior-Implant_Case-1_After.jpg';
import veneerBefore from '../assets/images/gallery/Anterior-Single-Veneer_Case-1_Before.jpg';
import veneerAfter from '../assets/images/gallery/Anterior-Single-Veneer_Case-1_After.jpg';
import crownBefore from '../assets/images/gallery/Single-Posterior-Crown_Case-1before.jpg';
import crownAfter from '../assets/images/gallery/Single-Posterior-Crown_Case-1_after.jpg';
import quadrantBefore from '../assets/images/gallery/Posterior-Quadrant_Case-1_Before.jpg';
import quadrantAfter from '../assets/images/gallery/Posterior-Quadrant_Case-1_After.jpg';
const cases = [
  { name: 'Anterior implant case', before: implantBefore, after: implantAfter, href: '/services/single-tooth-dental-implants-in-wauwatosa/', service: 'Single-tooth dental implants' },
  { name: 'Anterior single veneer case', before: veneerBefore, after: veneerAfter, href: '/services/cosmetic-dentistry-milwaukee/', service: 'Cosmetic dentistry' },
  { name: 'Single posterior crown case', before: crownBefore, after: crownAfter, href: '/services/cerec-crown-milwaukee/', service: 'CEREC crowns' },
  { name: 'Posterior quadrant case', before: quadrantBefore, after: quadrantAfter, href: '/services/restorative-dentistry/', service: 'Restorative dentistry' },
];
---
<section class="section-wrap smile-gallery" aria-label="Before and after cases">
  {cases.map((item, index) => <article class="smile-case">
    <div class="case-heading"><span aria-hidden="true">0{index + 1}</span><h2>{item.name}</h2><a class="text-link" href={item.href}>{item.service}</a></div>
    <div class="case-pair">{[{ label: 'Before', photo: item.before }, { label: 'After', photo: item.after }].map(({label, photo}) => <figure>
      <Image src={photo} widths={[320, 640, 900]} sizes="(max-width: 600px) 88vw, 43vw" format="webp" quality={90} alt={`${item.name}: ${label.toLowerCase()} treatment`} loading="lazy" />
      <figcaption>{label}</figcaption>
    </figure>)}</div>
  </article>)}
</section>
