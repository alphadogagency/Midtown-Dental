---
import SiteLayout from '../layouts/SiteLayout.astro';
import posts from '../data/blog-posts.json';
import archives from '../data/blog-archives.json';
import '../styles/interior.css';
import '../styles/blog.css';
const { archive, pageNumber = 1 } = Astro.props;
const allPosts = posts.filter(post => archive.posts.includes(post.path));
const pageCount = Math.ceil(allPosts.length / 10);
const listedPosts = allPosts.slice((pageNumber - 1) * 10, pageNumber * 10);
const pageUrl = (page: number) => `/${archive.path}/${page > 1 ? `page/${page}/` : ''}`;
const isMain = archive.type === 'all';
const date = (value: string) => new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(value));
const topics = archives.filter(item => item.type === 'category');
const title = `${archive.title}${pageNumber > 1 ? ` — Page ${pageNumber}` : ''} | MidTown Dental Care`;
---
<SiteLayout title={title} description={`Browse ${isMain ? 'dental articles and practice news' : archive.title + ' articles'} from the MidTown Dental Care archive.`}>
  <main id="main" class="blog-page">
    <header class="blog-heading archive-heading section-wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{!isMain && <><span aria-hidden="true">/</span><a href="/blog/">Patient Education</a></>}</nav>
      <p class="eyebrow">The MidTown journal</p><h1>{archive.title}</h1>
      <p class="blog-intro">{isMain ? 'Dental knowledge, practice news, and stories from our community.' : `From our archive: ${archive.title}.`}</p>
      <p class="blog-date">{allPosts.length} {allPosts.length === 1 ? 'article' : 'articles'}{pageCount > 1 && ` · Page ${pageNumber} of ${pageCount}`}</p>
    </header>
    <div class="blog-index-layout section-wrap">
      <div>
        <div class="blog-list">{listedPosts.map(post => <article class:list={['blog-list-item', { 'without-image': !post.image }]}>
          {post.image && <a href={`/${post.path}/`} tabindex="-1" aria-hidden="true"><img src={post.image.src} alt="" width={post.image.width} height={post.image.height} loading="lazy" decoding="async" /></a>}
          <div><time datetime={post.published}>{date(post.published)}</time><h2><a href={`/${post.path}/`}>{post.heading}</a></h2><p>{post.excerpt}</p><a class="text-link" href={`/${post.path}/`} aria-label={`Read ${post.heading}`}>Read article <span aria-hidden="true">→</span></a></div>
        </article>)}</div>
        {pageCount > 1 && <nav class="blog-pagination" aria-label="Article pagination">
          {pageNumber > 1 && <a href={pageUrl(pageNumber - 1)} rel="prev">← Previous</a>}
          {Array.from({ length: pageCount }, (_, i) => i + 1).map(number => <a href={pageUrl(number)} aria-label={`Page ${number}`} aria-current={number === pageNumber ? 'page' : undefined}>{number}</a>)}
          {pageNumber < pageCount && <a href={pageUrl(pageNumber + 1)} rel="next">Next →</a>}
        </nav>}
      </div>
      <aside class="blog-aside"><h2>Browse by topic</h2><nav aria-label="Blog categories"><a href="/blog/" aria-current={isMain ? 'page' : undefined}>All articles</a>{topics.map(topic => <a href={`/${topic.path}/`} aria-current={topic.path === archive.path ? 'page' : undefined}>{topic.title}</a>)}</nav><div class="blog-aside-care"><h2>Care at MidTown</h2><nav aria-label="Explore our practice"><a href="/dental-services/">Our dental services</a><a href="/team/">Meet the team</a><a href="/contact/">Get in touch</a></nav></div></aside>
    </div>
  </main>
</SiteLayout>
