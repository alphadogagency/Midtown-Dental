---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { practice, practiceSchema } from '../data/practice';
import { getImage } from 'astro:assets';
import receptionPhoto from '../assets/images/office-reception-updated.png';
import favicon from '../assets/images/favicon.png';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import '../styles/homepage.css';
interface Props { title: string; description: string; ogTitle?: string; home?: boolean; }
const { title, description, ogTitle = title, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, practice.site).href;
const isNotFound = Astro.url.pathname === '/404/';
const shareImage = await getImage({ src: receptionPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 85 });
const touchIcon = await getImage({ src: favicon, width: 180, height: 180, format: 'png' });
// Use the current host while staging so a share preview can actually fetch its image.
const previewOrigin = 'https://midtown-dental.pages.dev';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Preview protection: remove only after the documented migration gates pass. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#183e35" />
    <title>{title}</title>
    <link rel="icon" href="/images/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    {!isNotFound && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage.src, previewOrigin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The welcoming reception at MidTown Dental Care in Wauwatosa" />
    <script type="application/ld+json" set:html={JSON.stringify(practiceSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader home={home} />
    <slot />
    <SiteFooter home={home} />
    <nav class="mobile-contact-bar" aria-label="Quick contact">
      <a href={`tel:${practice.telephone}`}>Call {practice.phone}</a>
      <a href="/contact/">Request a visit</a>
    </nav>
  </body>
</html>
